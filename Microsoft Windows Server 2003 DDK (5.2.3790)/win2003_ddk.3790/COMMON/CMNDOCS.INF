[Version]
AdvancedInf = 2
Signature ="$CHICAGO$"
SetupClass = Base

[DefaultInstall]
CopyFiles=InfFiles,Files_0
CustomDestination= PDCDest
RequiredEngine = setupapi;
AddReg = RegVersion,DocKey

[DefaultUninstall]
DelFiles=InfFiles,Files_0
CustomDestination= PDCDest
DelReg = RegVersion,DocKey

[DestinationDirs]
Files_0=49000,"\help\"
InfFiles=17,"msddk\3790"
DefaultDestDir=49000,"CMNDOCS"

[RegVersion]
"HKLM","SOFTWARE\Microsoft\WINDDK\Restart\Cabs","CMNDOCS",0,"done"

[PDCDest]
49000,49001,49002=SDKCust, 17

[SDKCust]
;if key below exists, use this string to seed install path
"HKLM", "Software\Microsoft\WINDDK", "SFNDirectory",,"%DefaultDir%"

[DocKey]

[InfFiles]
CMNDOCS.inf


[Files_0]
winddk.chw,CMNDOCS_FILE_0,,

[SourceDisksNames]
1="CMNDOCS.cab",CMNDOCS.cab,0
[SourceDisksFiles]
CMNDOCS_FILE_0=1,,1


[Strings]
FriendlyName=Common_Docs_Files
AppKey=SOFTWARE\Microsoft\WINDDK
FileCount=1
TotalSize=1
