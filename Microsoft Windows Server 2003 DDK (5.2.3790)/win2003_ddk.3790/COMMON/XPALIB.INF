[Version]
AdvancedInf = 2
Signature ="$CHICAGO$"
SetupClass = Base

[DefaultInstall]
CopyFiles=InfFiles,Files_0
CustomDestination= PDCDest
RequiredEngine = setupapi;
AddReg = RegVersion,DocKey

[DefaultUninstall]
DelFiles=InfFiles,Files_0
CustomDestination= PDCDest
DelReg = RegVersion,DocKey

[DestinationDirs]
Files_0=49000,"\lib\wxp\"
InfFiles=17,"msddk\3790"
DefaultDestDir=49000,"XPALIB"

[RegVersion]
"HKLM","SOFTWARE\Microsoft\WINDDK\Restart\Cabs","XPALIB",0,"done"

[PDCDest]
49000,49001,49002=SDKCust, 17

[SDKCust]
;if key below exists, use this string to seed install path
"HKLM", "Software\Microsoft\WINDDK", "SFNDirectory",,"%DefaultDir%"

[DocKey]

[InfFiles]
XPALIB.inf


[Files_0]
stub512.com,XPALIB_FILE_0,,

[SourceDisksNames]
1="XPALIB.cab",XPALIB.cab,0
[SourceDisksFiles]
XPALIB_FILE_0=1,,512


[Strings]
FriendlyName=Wxp_Library_Files
AppKey=SOFTWARE\Microsoft\WINDDK
FileCount=1
TotalSize=512
