[Version]
AdvancedInf = 2
Signature ="$CHICAGO$"
SetupClass = Base

[DefaultInstall]
CopyFiles=InfFiles,Files_0
CustomDestination= PDCDest
RequiredEngine = setupapi;
AddReg = RegVersion,DocKey

[DefaultUninstall]
DelFiles=InfFiles,Files_0
CustomDestination= PDCDest
DelReg = RegVersion,DocKey

[DestinationDirs]
Files_0=49000,"\tools\avrf\"
InfFiles=17,"msddk\3790"
DefaultDestDir=49000,"TOOL_avrf"

[RegVersion]
"HKLM","SOFTWARE\Microsoft\WINDDK\Restart\Cabs","TOOL_avrf",0,"done"

[PDCDest]
49000,49001,49002=SDKCust, 17

[SDKCust]
;if key below exists, use this string to seed install path
"HKLM", "Software\Microsoft\WINDDK", "SFNDirectory",,"%DefaultDir%"

[DocKey]

[InfFiles]
TOOL_avrf.inf


[Files_0]
.empty ,TOOL_avrf_FILE_0,,

[SourceDisksNames]
1="TOOL_avrf.cab",TOOL_avrf.cab,0
[SourceDisksFiles]
TOOL_avrf_FILE_0=1,,3


[Strings]
FriendlyName=avrf_TOOL
AppKey=SOFTWARE\Microsoft\WINDDK
FileCount=1
TotalSize=3
