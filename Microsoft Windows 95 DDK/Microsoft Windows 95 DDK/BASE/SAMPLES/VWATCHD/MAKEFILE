# sample make file for building VwatchD virtual device for Windows

NAME = VWATCHD

#       Definitions for the debug level 

!ifdef DEBUG
DDEBUG  =-DDEBLEVEL=1 -DDEBUG
!else
DDEBUG  =-DDEBLEVEL=0
!endif

#       Definitions for MASM 6 Assembler

ASM    = ml
AFLAGS = -coff -DBLD_COFF -DIS_32 -W2 -c -Cx -Zm -DMASM6 $(DDEBUG)
ASMENV = ML
LFLAGS = /VXD /NOD

#       MASM 6 only inference rules

.asm.obj:
	set $(ASMENV)=$(AFLAGS)
	$(ASM) -Fo$*.obj $<
	set $(ASMENV)=

!ifdef MASTER_MAKE
all : $(NAME).vxd test.exe
!else
all : $(NAME).vxd
!endif

#
# to build test.exe run ddkenv 16 and run nmake test.exe
#
!ifdef MASTER_MAKE
test.exe: SET_BUILD_BITS_16 test.obj
!else
test.exe: test.obj
!endif
    link test.obj;

test.obj: test.c
    cl test.c -c -W3

VwatchD.obj: VwatchD.asm

OBJS =	VwatchD.obj

!ifdef MASTER_MAKE
$(NAME).vxd: SET_BUILD_BITS_32 $(NAME).def $(OBJS)
!else
$(NAME).vxd: $(NAME).def $(OBJS)
!endif
        link @<<$(NAME).lnk
$(LFLAGS) 
/OUT:$(NAME).vxd
/MAP:$(NAME).map
/DEF:$(NAME).def
$(OBJS)
<<
        mapsym -s -o $(NAME).sym $(NAME).map

!ifdef MASTER_MAKE
BUILD_TYPE=base
!INCLUDE $(DDKROOT)\master.mk
!endif


clean:
	-@del *.obj
	-@del *.vxd
	-@del *.exp
	-@del *.lib
	-@del *.map
	-@del *.sym
	-@del *.exe
