# sample make file for building vmpages virtual device for Windows

NAME = VMPAGES

#       Definitions for the debug level 

!ifdef DEBUG
DDEBUG  =-DDEBLEVEL=1 -DDEBUG
!else
DDEBUG  =-DDEBLEVEL=0
!endif

#       Definitions for MASM 6 Assembler

ASM    = ml
AFLAGS = -coff -DBLD_COFF -DIS_32 -W2 -c -Cx -Zm -DMASM6 $(DDEBUG)
ASMENV = ML
LFLAGS = /VXD /NOD

#       MASM 6 only inference rules

.asm.obj:
	set $(ASMENV)=$(AFLAGS)
	$(ASM) -Fo$*.obj $<
	set $(ASMENV)=

!ifdef MASTER_MAKE
all: $(NAME).vxd vmpgs.exe
!else
all: $(NAME).vxd
!endif

#
# to build vmpgs.exe run ddkenv 16 and run nmake vmpgs.exe
#
!ifdef MASTER_MAKE
vmpgs.exe : SET_BUILD_BITS_16 vmpgs.obj
!else
vmpgs.exe : vmpgs.obj
!endif
        link vmpgs.obj;

vmpgs.obj : vmpgs.asm vmpages.inc
        ml -W2 -c -Cx -Zm -DMASM6 $(DDEBUG) vmpgs.asm

vmpages.obj: vmpages.asm

OBJS =  vmpages.obj 

!ifdef MASTER_MAKE
$(NAME).vxd: SET_BUILD_BITS_32 $(NAME).def $(OBJS)
!else
$(NAME).vxd: $(NAME).def $(OBJS)
!endif
        link @<<$(NAME).lnk
$(LFLAGS) 
/OUT:$(NAME).vxd
/MAP:$(NAME).map
/DEF:$(NAME).def
$(OBJS)
<<
        mapsym -s -o $(NAME).sym $(NAME).map

!ifdef MASTER_MAKE
BUILD_TYPE=base
!INCLUDE $(DDKROOT)\master.mk
!endif

clean:
	-@del *.obj
	-@del *.vxd
	-@del *.exp
	-@del *.lib
	-@del *.map
	-@del *.sym
	-@del *.exe
