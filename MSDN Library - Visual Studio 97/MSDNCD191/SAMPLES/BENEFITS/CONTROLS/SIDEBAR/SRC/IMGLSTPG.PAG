VERSION 5.00
Begin VB.PropertyPage ImageListPage 
   Caption         =   "Imagelist"
   ClientHeight    =   1515
   ClientLeft      =   0
   ClientTop       =   0
   ClientWidth     =   5625
   PaletteMode     =   0  'Halftone
   ScaleHeight     =   1515
   ScaleWidth      =   5625
   Begin VB.ComboBox cboImageList2 
      Height          =   315
      Left            =   1440
      Sorted          =   -1  'True
      TabIndex        =   3
      Top             =   720
      Width           =   2055
   End
   Begin VB.ComboBox cboImageList 
      Appearance      =   0  'Flat
      Height          =   315
      ItemData        =   "ImgLstPg.pgx":0000
      Left            =   1440
      List            =   "ImgLstPg.pgx":0002
      Sorted          =   -1  'True
      TabIndex        =   1
      Top             =   240
      Width           =   2055
   End
   Begin VB.Label lblImageList 
      Caption         =   "&Small Icons :"
      Height          =   195
      Index           =   1
      Left            =   210
      TabIndex        =   2
      Top             =   720
      Width           =   1065
   End
   Begin VB.Label lblImageList 
      Caption         =   "&Large Icons :"
      Height          =   195
      Index           =   0
      Left            =   210
      TabIndex        =   0
      Top             =   300
      Width           =   1065
   End
End
Attribute VB_Name = "ImageListPage"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
'ImageListPage.pag
'Date        - 10/24/96
'Author      - Phil Johnson, MG Components
'Purpose     - Property Page for VB SideBar Control

Private Sub cboImageList_Change()
    Changed = True
End Sub
Private Sub cboImageList_Click()
    Changed = True
End Sub

Private Sub cboImageList2_Change()
    Changed = True
End Sub

Private Sub cboImageList2_Click()
    Changed = True
End Sub

Private Sub PropertyPage_ApplyChanges()
    'Has anything been selected
    If Len(cboImageList.Text) Then
        SelectedControls(0).LargeImageList = cboImageList.Text
    End If
    If Len(cboImageList2.Text) Then
        SelectedControls(0).SmallImageList = cboImageList2.Text
    End If
End Sub
Private Sub PropertyPage_SelectionChanged()

    'Clear the list
    cboImageList.Clear
    cboImageList2.Clear
    
    'Enum the container to see if there are any ImageLists
    Dim I As Long
    For I = 0 To SelectedControls(0).ParentControls.Count - 1
        If TypeName(SelectedControls(0).ParentControls(I)) = "ImageList" Then
            cboImageList.AddItem SelectedControls(0).ParentControls(I).Name
            cboImageList2.AddItem SelectedControls(0).ParentControls(I).Name
        End If
    Next I

    cboImageList.Text = SelectedControls(0).LargeImageList
    cboImageList2.Text = SelectedControls(0).SmallImageList
    cboImageList.Refresh
    cboImageList2.Refresh
    PropertyPage.Refresh

End Sub
