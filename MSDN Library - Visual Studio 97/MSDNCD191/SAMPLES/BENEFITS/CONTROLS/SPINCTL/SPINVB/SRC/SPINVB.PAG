Private Sub txtIncrement_Change()
Changed = True
End Sub

Private Sub txtMaximum_Change()
Changed = True
End Sub

Private Sub txtMinimum_Change()
Changed = True
End Sub

Private Sub txtValue_Change()
Changed = True
End Sub

Private Sub PropertyPage_ApplyChanges()
Dim oControl As Variant
For Each oControl In SelectedControls
    oControl.Minimum = txtMinimum.Text
    oControl.Maximum = txtMaximum.Text
    oControl.Increment = txtIncrement.Text
    oControl.Value = txtValue.Text
Next
End Sub

Private Sub PropertyPage_SelectionChanged()
txtMinimum.Text = SelectedControls(0).Minimum
txtMaximum.Text = SelectedControls(0).Maximum
txtIncrement.Text = SelectedControls(0).Increment
txtValue.Text = SelectedControls(0).Value
End Sub

