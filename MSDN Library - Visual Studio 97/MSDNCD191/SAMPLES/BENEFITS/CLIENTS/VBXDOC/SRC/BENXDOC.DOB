Attribute VB_Name = "benxdoc"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
'BenXDoc.dob - Copyright (C) 1996 Microsoft Corporation
'            - All rights reserved.
'Date        - 12/20/96
'Authors     - Ken Bergmann
'Purpose     - ActiveX Document Client for Benefits API
Option Explicit

Private oAdmin      As New CAdmin
Private bAdmin      As Boolean
Private bUpdate     As Boolean
Private iCurrentPic As Integer
Private lPKId       As Long
Private sDataSource As String
Private sUser       As String

Private Const icEmployee = 0
Private Const icBenefit = 1
Private Const icBank = 2
Private Const icDependant = 3
Private Const icBenefitLink = 4

Private Const icDoDataDirect = 1

Private Const icInvalidUser = 0
Private Const icValidUser = 1
Private Const icValidAdmin = 2
'ClearBank
'Purpose     - Clear bank controls
Private Sub ClearBank()
txtBankName = ""
txtBankAddress1 = ""
txtBankAddress2 = ""
txtBankCity = ""
txtBankCode = ""
End Sub

'ClearBenefit
'Purpose     - Clear benefit controls
Private Sub ClearBenefit()
txtBenefitDesc = ""
txtBenefitCost = ""
txtBenefitIncrement = ""
txtBenefitMultiples = ""
txtBenefitMaximum = ""
txtBenefitMinimum = ""
cmbBenefitTax.ListIndex = -1
cmbBenefitType.ListIndex = -1
End Sub

'ClearBenefitLink
'Purpose     - Clear benefit link controls
Private Sub ClearBenefitLink()
lblBenefitLinkID = ""
txtBenefitLinkAmount = ""
cmbBenefitDesc.ListIndex = -1
cmbBenefitLinkCoverage.ListIndex = -1
cmbBenefitLinkTax.ListIndex = -1
End Sub

'ClearDependant
'Purpose     - Clear dependant controls
Private Sub ClearDependant()
lblDependantID = ""
txtDependantFirstName = ""
txtDependantLastName = ""
txtDependantBD = ""
cmbDependantType.ListIndex = -1
optDependantStatus(0) = True
optDependantGender(0) = True
End Sub

'ClearEmployee
'Purpose     - Clear employee controls
Private Sub ClearEmployee()
txtEmployeeFirstName = ""
txtEmployeeLastName = ""
txtEmployeeAddress1 = ""
txtEmployeeAddress2 = ""
txtEmployeeCity = ""
txtEmployeeSalary = ""
txtEmployeePosition = ""
txtEmployeeBD = ""
txtEmployeeStartDate = ""
txtEmployeeEndDate = ""
txtEmployeeUserName = ""
optEmployeeGender(0) = True
cmbBank.Text = ""
txtEmployeeBankAccount = ""
End Sub

'CurrentPanel
'Purpose     - Returns the current active panle
'Outputs     - (Integer) Indicates panel index
Function CurrentPanel() As Integer
Dim iPanel As Integer
For iPanel = pnlMain.LBound To pnlMain.UBound
    If pnlMain(iPanel).Visible Then
        CurrentPanel = iPanel
        Exit Function
    End If
Next iPanel
CurrentPanel = 0
End Function

'DspBank
'Purpose     - Display Bank
Sub DspBank()
Dim oEmp    As CEmployee
Dim oBnk    As CBank
Dim oEmps   As CListEmployee
Dim nTmp    As ComctlLib.Node
Dim lBnk    As Long
Dim sKey    As String

On Error Resume Next

Set nTmp = tvwMain.Nodes(tvwMain.SelectedItem.Key)
sKey = nTmp.Key
If nTmp Is Nothing Then
    ClearBank
Else
    lBnk = CLng(Mid$(nTmp.Tag, 2))
    Set nTmp = Nothing
    Set oBnk = oAdmin.Banks(lBnk)
    txtBankName = oBnk.Name
    txtBankAddress1 = oBnk.Address1
    txtBankAddress2 = oBnk.Address2
    txtBankCity = oBnk.City
    txtBankCode = oBnk.Code
    
    'Fill Employees
    If bAdmin Then
        Set oEmps = oBnk.Employees
        Set nTmp = tvwMain.Nodes.Add(sKey, tvwChild, "SB!" & sKey, "Employees")
        nTmp.Image = "Employees"
        For Each oEmp In oEmps
            Err = False
            Set nTmp = tvwMain.Nodes.Add("SB!" & sKey, tvwChild, "E" & CStr(oEmp.PKId) & "!" & sKey, oEmp.LastName & ", " & oEmp.FirstName)
            If Not CBool(Err) Then
                nTmp.Tag = "E" & CStr(oEmp.PKId)
                nTmp.Image = "Employee"
            End If
        Next oEmp
        Set nTmp = Nothing
        Set oEmp = Nothing
        Set oEmps = Nothing
    End If
    Set oBnk = Nothing
End If
If Not bAdmin Then
    btInsert.Enabled = False
    btUpdate.Enabled = True
    btDelete.Enabled = False
End If
End Sub

'DspBenefit
'Purpose     - Display benefit
Sub DspBenefit()
Dim oBnf As CBenefit
Dim nTmp As ComctlLib.Node
Dim lBnf As Long

On Error Resume Next

Set nTmp = tvwMain.SelectedItem
If nTmp Is Nothing Then
    ClearBenefit
Else
    lBnf = CLng(Mid$(nTmp.Tag, 2))
    Set oBnf = oAdmin.Benefits(lBnf)
    txtBenefitDesc = oBnf.Description
    FindItem cmbBenefitTax, oBnf.BnfTaxId
    FindItem cmbBenefitType, oBnf.BnfTypeId
    txtBenefitCost = oBnf.Cost
    txtBenefitIncrement = oBnf.Increment
    txtBenefitMaximum = oBnf.Maximum
    txtBenefitMinimum = oBnf.Minimum
    txtBenefitMultiples = oBnf.Multiples
    Set oBnf = Nothing
End If
End Sub

'DspBenefitLink
'Purpose     - Display benefit link
Sub DspBenefitLink()
Dim oBnfLnk As CBenefitLink
Dim nTmp As ComctlLib.Node
Dim lBnfLnk As Long
Dim lEmp As Long

On Error Resume Next

Set nTmp = tvwMain.SelectedItem
If nTmp Is Nothing Then
    ClearBenefitLink
Else
    lEmp = CLng(Mid$(nTmp.Parent.Parent.Tag, 2))
    lBnfLnk = CLng(Mid$(nTmp.Tag, 2))
    Set oBnfLnk = oAdmin.Employees(lEmp).BenefitLinks(lBnfLnk)
    lblBenefitLinkID = oBnfLnk.PKId
    FindItem cmbBenefitDesc, oBnfLnk.Benefit.PKId
    txtBenefitLinkAmount = oBnfLnk.Amount
    FindItem cmbBenefitLinkCoverage, oBnfLnk.CoverageId
    FindItem cmbBenefitLinkTax, oBnfLnk.TaxId
    Set oBnfLnk = Nothing
End If
If Not bAdmin Then
    btInsert.Enabled = False
    btUpdate.Enabled = True
    btDelete.Enabled = True
End If
End Sub

'DspDependant
'Purpose     - Display dependant
Sub DspDependant()
Dim oDep As CDependant
Dim nTmp As ComctlLib.Node
Dim lEmp As Long
Dim lDep As Long

'On Error Resume Next

Set nTmp = tvwMain.SelectedItem
If nTmp Is Nothing Then
    ClearBenefitLink
Else
    lEmp = CLng(Mid$(nTmp.Parent.Parent.Tag, 2))
    lDep = CLng(Mid$(nTmp.Tag, 2))
    Set oDep = oAdmin.Employees(lEmp).Dependants(lDep)
    lblDependantID = oDep.PKId
    txtDependantFirstName = oDep.FirstName
    txtDependantLastName = oDep.LastName
    txtDependantBD = oDep.DateOfBirth
    FindItem cmbDependantType, oDep.DepTypeId
    If oDep.Status Then
        optDependantStatus(0) = True
    Else
        optDependantStatus(1) = True
    End If
    If oDep.Gender Then
        optDependantGender(0) = True
    Else
        optDependantGender(1) = True
    End If
    Set oDep = Nothing
End If
If Not bAdmin Then
    btInsert.Enabled = False
    btUpdate.Enabled = True
    btDelete.Enabled = True
End If
End Sub

'DspEmployee
'Purpose     - Display employee
Sub DspEmployee()
Dim oEmp As CEmployee
Dim nTmp As ComctlLib.Node
Dim lEmp As Long
Dim sKey As String

Dim oBnfLnks As CListBenefitLink
Dim oDeps As CListDependant
Dim oBnfLnk As CBenefitLink
Dim oDep As CDependant
Dim oBnk As CBank

On Error Resume Next
Set nTmp = tvwMain.Nodes(tvwMain.SelectedItem.Key)
sKey = nTmp.Key
If nTmp Is Nothing Then
    ClearEmployee
Else
    lEmp = CLng(Mid$(nTmp.Tag, 2))
    Set oEmp = oAdmin.Employees(lEmp)
    txtEmployeeFirstName = oEmp.FirstName
    txtEmployeeLastName = oEmp.LastName
    txtEmployeeAddress1 = oEmp.Address1
    FindItem cmbBank, oEmp.Bank.PKId
    txtEmployeeBankAccount = oEmp.BankAccount
    txtEmployeeCity = oEmp.City
    txtEmployeeBD = oEmp.DateOfBirth
    txtEmployeeSalary = oEmp.Salary
    txtEmployeeStartDate = oEmp.StartDate
    txtEmployeeEndDate = oEmp.EndDate
    txtEmployeePosition = oEmp.Position
    txtEmployeeUserName = oEmp.UserName
    If oEmp.Gender Then
        optEmployeeGender(0) = True
    Else
        optEmployeeGender(1) = True
    End If
    Set oDeps = oEmp.Dependants
    Set oBnfLnks = oEmp.BenefitLinks
    
    'Fill Dependants
    Err = False
    Set nTmp = tvwMain.Nodes.Add(sKey, tvwChild, "SD!" & sKey, "Dependants")
    If Not CBool(Err) Then
        nTmp.Image = "Dependants"
        For Each oDep In oDeps
            Err = False
            Set nTmp = tvwMain.Nodes.Add("SD!" & sKey, tvwChild, "D" & CStr(oDep.PKId) & "!" & sKey, oDep.LastName & ", " & oDep.FirstName)
            If Not CBool(Err) Then
                nTmp.Tag = "D" & CStr(oDep.PKId)
                nTmp.Image = "Dependant"
            End If
        Next oDep
    End If
    Set oDep = Nothing
    Set oDeps = Nothing
    
    'Fill Benefits
    Err = False
    Set nTmp = tvwMain.Nodes.Add(sKey, tvwChild, "SF!" & sKey, "Benefits")
    If Not CBool(Err) Then
        nTmp.Image = "Benefits"
        For Each oBnfLnk In oBnfLnks
            Err = False
            Set nTmp = tvwMain.Nodes.Add("SF!" & sKey, tvwChild, "F" & CStr(oBnfLnk.PKId) & "!" & sKey, oBnfLnk.Benefit.Description)
            If Not CBool(Err) Then
                nTmp.Tag = "F" & CStr(oBnfLnk.PKId)
                nTmp.Image = "Benefit"
            End If
        Next oBnfLnk
    End If
    Set oBnfLnk = Nothing
    Set oBnfLnks = Nothing
    
    'Add Bank Node
    Err = False
    Set nTmp = tvwMain.Nodes.Add(sKey, tvwChild, "B" & CStr(oEmp.Bank.PKId) & "!" & sKey, oEmp.Bank.Name & " (" & oEmp.Bank.Code & ")")
    If Not CBool(Err) Then
        nTmp.Tag = "B" & CStr(oEmp.Bank.PKId)
        nTmp.Image = "Bank"
    End If
    Set oEmp = Nothing
End If
If Not bAdmin Then
    btInsert.Enabled = False
    btUpdate.Enabled = True
    btDelete.Enabled = False
End If
End Sub

'FillDomain
'Purpose     - Fill a control with a list
'Inputs      - (Variant)    lstControl
'            - (oDomain)    CList
Sub FillDomain(lstControl, oDomain As CList)
Dim oList   As CList

lstControl.Clear
For Each oList In oDomain
    lstControl.AddItem oList("Description")
    lstControl.ItemData(lstControl.NewIndex) = oList("PKId")
Next oList
Set oList = Nothing
End Sub

'FindItem
'Purpose     - Searches for an itemdata and selects the item
'Assumptions - N/A
'Inputs      - (Control)    ctlMe
'            - (Integer)    iItem
Private Sub FindItem(ctlMe As Control, ByVal iItem As Integer)
Dim iIndex As Integer
ctlMe.ListIndex = -1
For iIndex = 0 To ctlMe.ListCount - 1
    If ctlMe.ItemData(iIndex) = iItem Then
        ctlMe.ListIndex = iIndex
        Exit For
    End If
Next iIndex
End Sub

'LoadBanks
'Purpose     - Load control with banks
Sub LoadBanks()
Dim oBank As CBank
cmbBank.Clear
For Each oBank In oAdmin.Banks
    cmbBank.AddItem oBank.Name
    cmbBank.ItemData(cmbBank.NewIndex) = oBank.PKId
Next oBank
Set oBank = Nothing
End Sub

'LoadBenefits
'Purpose     - Load control with benefits
Sub LoadBenefits()
Dim oBenefit As CBenefit
cmbBenefitDesc.Clear
For Each oBenefit In oAdmin.Benefits
    cmbBenefitDesc.AddItem oBenefit.Description
    cmbBenefitDesc.ItemData(cmbBenefitDesc.NewIndex) = oBenefit.PKId
Next oBenefit
Set oBenefit = Nothing
End Sub

'MoveButtons
'Purpose     - Move the buttons
'Inputs      - (Integer)    iWhere
Sub MoveButtons(ByVal iWhere As Integer)
Select Case iWhere
    Case 0:
        btInsert.Move 3200, 960
        btUpdate.Move 3200, 1260
        btDelete.Move 3200, 1560
    Case 1:
        btInsert.Move 7000, 3870
        btUpdate.Move 7000, 4170
        btDelete.Move 7000, 4470
End Select
DoEvents
End Sub

'ShowAdmin
'Purpose     - Show admin view of data
Sub ShowAdmin()
Dim nTemp As ComctlLib.Node
Dim oEmps As CListEmployee
Dim oBnks As CListBank
Dim oBnfs As CListBenefit
Dim oEmp As CEmployee
Dim oBnk As CBank
Dim oBnf As CBenefit

'hide current panel if updating
pnlMain(CurrentPanel).Visible = False
MoveButtons 0
btUpdate.Enabled = False
btDelete.Enabled = False

oAdmin.FillListEmployees
Set oEmps = oAdmin.Employees

oAdmin.FillListBanks
Set oBnks = oAdmin.Banks

oAdmin.FillListBenefits
Set oBnfs = oAdmin.Benefits

tvwMain.Nodes.Clear

'Fill Employees
Set nTemp = tvwMain.Nodes.Add(Key:="MEmployee", Text:="Employees")
nTemp.Image = "Employees"
For Each oEmp In oEmps
    Set nTemp = tvwMain.Nodes.Add("MEmployee", tvwChild, "E" & CStr(oEmp.PKId), oEmp.LastName & ", " & oEmp.FirstName)
    nTemp.Tag = "E" & CStr(oEmp.PKId)
    nTemp.Image = "Employee"
Next oEmp
Set oEmp = Nothing
Set oEmps = Nothing

'Fill Benefits
Set nTemp = tvwMain.Nodes.Add(Key:="MBenefit", Text:="Benefits")
nTemp.Image = "Benefits"
For Each oBnf In oBnfs
    Set nTemp = tvwMain.Nodes.Add("MBenefit", tvwChild, "F" & CStr(oBnf.PKId), oBnf.Description)
    nTemp.Tag = "F" & CStr(oBnf.PKId)
    nTemp.Image = "Benefit"
Next oBnf
Set oBnf = Nothing
Set oBnfs = Nothing

'Fill Banks
Set nTemp = tvwMain.Nodes.Add(Key:="MBank", Text:="Banks")
nTemp.Image = "Bank"
For Each oBnk In oBnks
    Set nTemp = tvwMain.Nodes.Add("MBank", tvwChild, "B" & CStr(oBnk.PKId), oBnk.Name & " (" & oBnk.Code & ")")
    nTemp.Tag = "B" & CStr(oBnk.PKId)
    nTemp.Image = "Bank"
Next oBnk
Set oBnk = Nothing
Set oBnks = Nothing

LoadBanks
LoadBenefits
    
lblCurrent = "Administrator"
lblCurrent.Visible = True
End Sub

'ShowPanel
'Purpose     - Show a panel
'Inputs      - (Integer)    iPanel
Sub ShowPanel(ByVal iPanel As Integer)
Dim iIndex As Integer

pnlMain(iPanel).Visible = True
If btInsert.Caption = "&Insert" Then btInsert.Enabled = False
If bAdmin Then btUpdate.Enabled = True
If bAdmin And btInsert.Caption = "&Insert" Then btDelete.Enabled = True
pnlMain(iPanel).ZOrder
For iIndex = icEmployee To icBenefitLink
    If iIndex <> iPanel Then pnlMain(iIndex).Visible = False
Next iIndex
MoveButtons 1
btInsert.ZOrder
btUpdate.ZOrder
btDelete.ZOrder
End Sub

'ShowUser
'Purpose     - Show a user view of data
Sub ShowUser()
Dim oEmp    As New CEmployee
Dim oLst    As CList
Dim nTemp   As ComctlLib.Node
Dim sTemp   As String

oAdmin.FillListEmployees
oAdmin.FillListBenefits
oAdmin.FillListBanks

tvwMain.Nodes.Clear
btDelete.Enabled = False
LoadBanks
LoadBenefits

If oAdmin.ExecFillList("SELECT * FROM tbEmployee WHERE UserName = '" & sUser & "'", oLst) Then
    oEmp.PKId = oLst("PKId")
    Set oEmp.Admin = oAdmin
    sTemp = oEmp.LastName & ", " & oEmp.FirstName
    Set nTemp = tvwMain.Nodes.Add(Key:="E" & CStr(oEmp.PKId), Text:=sTemp)
    nTemp.Tag = "E" & CStr(oEmp.PKId)
    Set oEmp = Nothing
    nTemp.Image = "Employee"
    nTemp.Selected = True
    Set tvwMain.SelectedItem = tvwMain.Nodes(nTemp.Key)
    DspEmployee
    ShowPanel icEmployee
    lblCurrent = sTemp
    lblCurrent.Visible = True
End If
End Sub

Private Sub btDelete_Click()
On Error GoTo errbtDelete_Click
Screen.MousePointer = vbHourglass
Select Case CurrentPanel
    Case icEmployee:
        Dim oEmployee As CEmployee
        Set oEmployee = oAdmin.Employees(CLng(Mid$(tvwMain.SelectedItem.Tag, 2)))
        oAdmin.Delete oEmployee:=oEmployee
    Case icBenefit:
        Dim oBenefit As CBenefit
        Set oBenefit = oAdmin.Benefits(CLng(Mid$(tvwMain.SelectedItem.Tag, 2)))
        oAdmin.Delete oBenefit:=oBenefit
    Case icBank:
        Dim oBank As CBank
        Set oBank = oAdmin.Banks(CLng(Mid$(tvwMain.SelectedItem.Tag, 2)))
        oAdmin.Delete oBank:=oBank
    Case icDependant:
        Dim oDependant As CDependant
        Set oDependant = oAdmin.Employees(CLng(Mid$(tvwMain.SelectedItem.Parent.Parent.Tag, 2))).Dependants(CLng(lblDependantID))
        oAdmin.Delete oDependant:=oDependant
    Case icBenefitLink:
        Dim oBenefitLink As CBenefitLink
        Set oBenefitLink = oAdmin.Employees(CLng(Mid$(tvwMain.SelectedItem.Parent.Parent.Tag, 2))).BenefitLinks(CLng(lblBenefitLinkID))
        oAdmin.Delete oBenefitLink:=oBenefitLink
End Select
pnlMain(CurrentPanel).Visible = False
MoveButtons 0
btInsert.Enabled = True
If bAdmin Then
    ShowAdmin
Else
    ShowUser
End If
Screen.MousePointer = vbDefault
Exit Sub
errbtDelete_Click:
MsgBox Err.Description, vbExclamation, "Delete Error"
Screen.MousePointer = vbDefault
Exit Sub
End Sub

Private Sub btInsert_Click()
On Error GoTo errbtInsert_Click
Dim nTemp As ComctlLib.Node
Dim sKey As String

Screen.MousePointer = vbHourglass
Select Case btInsert.Caption
    Case "&Insert":
        btInsert.Caption = "Ok"
        btUpdate.Caption = "Cancel"
        btDelete.Enabled = False
        fraTreeView.Enabled = False
        Select Case tvwMain.SelectedItem
            Case "Employees":
                ClearEmployee
                ShowPanel icEmployee
            Case "Benefits":
                If tvwMain.SelectedItem.Key = "MBenefit" Then
                    ClearBenefit
                    ShowPanel icBenefit
                Else
                    ClearBenefitLink
                    ShowPanel icBenefitLink
                End If
            Case "Banks":
                ClearBank
                ShowPanel icBank
            Case "Dependants":
                ClearDependant
                ShowPanel icDependant
            Case Else:
                btInsert.Caption = "&Insert"
                btUpdate.Caption = "&Update"
                btDelete.Enabled = True
                fraTreeView.Enabled = True
                MsgBox "Select appropriate node for insert.", vbInformation, "Benefits 1997"
        End Select
    Case "Ok":
        Select Case tvwMain.SelectedItem
            Case "Employees":
                Dim oEmployee As New CEmployee
                oEmployee.FirstName = txtEmployeeFirstName
                oEmployee.LastName = txtEmployeeLastName
                oEmployee.Address1 = txtEmployeeAddress1
                Set oEmployee.Bank = oAdmin.Banks(cmbBank.ItemData(cmbBank.ListIndex))
                oEmployee.BankAccount = txtEmployeeBankAccount
                oEmployee.City = txtEmployeeCity
                oEmployee.DateOfBirth = txtEmployeeBD
                oEmployee.Salary = txtEmployeeSalary
                oEmployee.StartDate = txtEmployeeStartDate
                oEmployee.EndDate = txtEmployeeEndDate
                oEmployee.Position = txtEmployeePosition
                oEmployee.UserName = txtEmployeeUserName
                If optEmployeeGender(0) Then
                    oEmployee.Gender = True
                Else
                    oEmployee.Gender = False
                End If
                oAdmin.Insert oEmployee:=oEmployee
                Set oEmployee = Nothing
            Case "Benefits":
                If tvwMain.SelectedItem.Key = "MBenefit" Then
                    Dim oBenefit As New CBenefit
                    oBenefit.Description = txtBenefitDesc
                    oBenefit.BnfTaxId = cmbBenefitTax.ItemData(cmbBenefitTax.ListIndex)
                    oBenefit.BnfTypeId = cmbBenefitType.ItemData(cmbBenefitType.ListIndex)
                    oBenefit.Cost = txtBenefitCost
                    oBenefit.Increment = txtBenefitIncrement
                    oBenefit.Maximum = txtBenefitMaximum
                    oBenefit.Minimum = txtBenefitMinimum
                    oBenefit.Multiples = txtBenefitMultiples
                    oAdmin.Insert oBenefit:=oBenefit
                    Set oBenefit = Nothing
                Else
                    Dim oBenefitLink As New CBenefitLink
                    Set oBenefitLink.Employee = oAdmin.Employees(CLng(Mid$(tvwMain.SelectedItem.Parent.Tag, 2)))
                    Set oBenefitLink.Benefit = oAdmin.Benefits(cmbBenefitDesc.ItemData(cmbBenefitDesc.ListIndex))
                    oBenefitLink.CoverageId = cmbBenefitLinkCoverage.ItemData(cmbBenefitLinkCoverage.ListIndex)
                    oBenefitLink.TaxId = cmbBenefitLinkTax.ItemData(cmbBenefitLinkTax.ListIndex)
                    oBenefitLink.Amount = txtBenefitLinkAmount
                    oAdmin.Insert oBenefitLink:=oBenefitLink
                    Set oBenefitLink = Nothing
                End If
            Case "Banks":
                Dim oBank As New CBank
                oBank.Name = txtBankName
                oBank.Address1 = txtBankAddress1
                oBank.Address2 = txtBankAddress2
                oBank.City = txtBankCity
                oBank.Code = txtBankCode
                oAdmin.Insert oBank:=oBank
                Set oBank = Nothing
            Case "Dependants":
                Dim oDependant As New CDependant
                oDependant.FirstName = txtDependantFirstName
                oDependant.LastName = txtDependantLastName
                oDependant.DateOfBirth = txtDependantBD
                oDependant.DepTypeId = cmbDependantType.ItemData(cmbDependantType.ListIndex)
                If optDependantGender(0) Then
                    oDependant.Gender = True
                Else
                    oDependant.Gender = False
                End If
                If optDependantStatus(0) Then
                    oDependant.Status = True
                Else
                    oDependant.Status = False
                End If
                Set oDependant.Employee = oAdmin.Employees(CLng(Mid$(tvwMain.SelectedItem.Parent.Tag, 2)))
                oAdmin.Insert oDependant:=oDependant
                Set oDependant = Nothing
        End Select
        If bAdmin Then
            ShowAdmin
        Else
            ShowUser
        End If
        btInsert.Caption = "&Insert"
        btUpdate.Caption = "&Update"
        fraTreeView.Enabled = True
End Select
Screen.MousePointer = vbDefault
Exit Sub
errbtInsert_Click:
MsgBox Err.Description, vbExclamation, "Insert Error"
Screen.MousePointer = vbDefault
Exit Sub
End Sub

Private Sub btLogin_Click()
Dim oLst  As CList
Dim bODBC As Boolean
Dim iUser As Integer
Dim sDS   As String

On Error Resume Next

If Not (oAdmin Is Nothing) Then
    oAdmin.Term
    Set oAdmin = Nothing
    Set oAdmin = New CAdmin
End If
If optDatabase(0).Value Then
    bODBC = True
    sDS = "ODBC;DSN=" & sDataSource & ";"
Else
    If optDatabase(1).Value Then
        bODBC = False
        sDS = sDataSource
    Else
        MsgBox "Please select datasource", vbOKOnly
        Exit Sub
    End If
End If
lblStatus = "Loading Services from ..." & sDataSource
lblStatus.Refresh
lblCurrent.Visible = False
If Not oAdmin.Init(bODBC, sDS, icDoDataDirect, 0, 0) Then
    MsgBox "Could not connect to data source.", vbOKOnly
    Set oAdmin = Nothing
    lblStatus = "Current Data Source = " & sDataSource
    lblStatus.Refresh
    Exit Sub
Else
    lblStatus = "Validating UserName..."
    lblStatus.Refresh
    sUser = Trim$(txtUserName)
    iUser = oAdmin.IsUserValid(sUser)
    If iUser = icInvalidUser Then
        MsgBox "Invalid user name.", vbOKOnly
        lblStatus = "Current Data Source = " & sDataSource
        lblStatus.Refresh
        Exit Sub
    End If
    
    lblStatus = "Retrieving Domain Data...Benefit Tax Types"
    lblStatus.Refresh
    If oAdmin.GetBenefitTaxTypes(oLst) Then FillDomain cmbBenefitTax, oLst
    lblStatus = "Retrieving Domain Data...Benefit Types"
    lblStatus.Refresh
    If oAdmin.GetBenefitTypes(oLst) Then FillDomain cmbBenefitType, oLst
    lblStatus = "Retrieving Domain Data...Dependant Types"
    lblStatus.Refresh
    If oAdmin.GetDependantTypes(oLst) Then FillDomain cmbDependantType, oLst
    lblStatus = "Retrieving Domain Data...Employee Benefit Coverage Types"
    lblStatus.Refresh
    If oAdmin.GetEmployeeBenefitCoverageTypes(oLst) Then FillDomain cmbBenefitLinkCoverage, oLst
    lblStatus = "Retrieving Domain Data...Employee Benefit Tax Types"
    lblStatus.Refresh
    If oAdmin.GetEmployeeBenefitTaxTypes(oLst) Then FillDomain cmbBenefitLinkTax, oLst
    Set oLst = Nothing
    
    If iUser = icValidAdmin Then
        bAdmin = True
        lblStatus = "Preparing Administration Mode..."
        lblStatus.Refresh
        ShowAdmin
    Else
        If iUser = icValidUser Then
            bAdmin = False
            lblStatus = "Preparing User Mode..."
            lblStatus.Refresh
            ShowUser
        Else
            MsgBox "Invalid user name.", vbOKOnly
            lblStatus = "Current Data Source = " & sDataSource
            lblStatus.Refresh
            Exit Sub
        End If
    End If
    
    lblStatus = ""
    lblStatus.Refresh
    lblUserName.Visible = False
    txtUserName.Visible = False
    btLogin.Visible = False
    btInsert.Visible = True
    btUpdate.Visible = True
    btDelete.Visible = True
    optDatabase(0).Visible = False
    optDatabase(1).Visible = False
    tvwMain.Visible = True
    fraTreeView.Visible = True
End If
End Sub

Private Sub btUpdate_Click()
On Error GoTo errbtUpdate_Click
Screen.MousePointer = vbHourglass
Select Case btUpdate.Caption
    Case "&Update":
        lblCurrent = "Updating..."
        Screen.MousePointer = vbHourglass
        btInsert.Visible = False
        btUpdate.Visible = False
        btDelete.Visible = False
        Select Case CurrentPanel
            Case icEmployee:
                Dim oEmployee As CEmployee
                Set oEmployee = oAdmin.Employees(CLng(Mid$(tvwMain.SelectedItem.Tag, 2)))
                oEmployee.FirstName = txtEmployeeFirstName
                oEmployee.LastName = txtEmployeeLastName
                oEmployee.Address1 = txtEmployeeAddress1
                Set oEmployee.Bank = oAdmin.Banks(cmbBank.ItemData(cmbBank.ListIndex))
                oEmployee.BankAccount = txtEmployeeBankAccount
                oEmployee.City = txtEmployeeCity
                oEmployee.DateOfBirth = txtEmployeeBD
                oEmployee.Salary = txtEmployeeSalary
                oEmployee.StartDate = txtEmployeeStartDate
                oEmployee.EndDate = txtEmployeeEndDate
                oEmployee.Position = txtEmployeePosition
                oEmployee.UserName = txtEmployeeUserName
                If optEmployeeGender(0) Then
                    oEmployee.Gender = True
                Else
                    oEmployee.Gender = False
                End If
                oAdmin.Update oEmployee:=oEmployee
            Case icBenefit:
                Dim oBenefit As CBenefit
                Set oBenefit = oAdmin.Benefits(CLng(Mid$(tvwMain.SelectedItem.Tag, 2)))
                oBenefit.Description = txtBenefitDesc
                oBenefit.BnfTaxId = cmbBenefitTax.ItemData(cmbBenefitTax.ListIndex)
                oBenefit.BnfTypeId = cmbBenefitType.ItemData(cmbBenefitType.ListIndex)
                oBenefit.Cost = txtBenefitCost
                oBenefit.Increment = txtBenefitIncrement
                oBenefit.Maximum = txtBenefitMaximum
                oBenefit.Minimum = txtBenefitMinimum
                oBenefit.Multiples = txtBenefitMultiples
                oAdmin.Update oBenefit:=oBenefit
            Case icBenefitLink:
                Dim oBenefitLink As CBenefitLink
                Set oBenefitLink = oAdmin.Employees(CLng(Mid$(tvwMain.SelectedItem.Parent.Parent.Tag, 2))).BenefitLinks(CLng(lblBenefitLinkID))
                Set oBenefitLink.Benefit = oAdmin.Benefits(cmbBenefitDesc.ItemData(cmbBenefitDesc.ListIndex))
                oBenefitLink.CoverageId = cmbBenefitLinkCoverage.ItemData(cmbBenefitLinkCoverage.ListIndex)
                oBenefitLink.TaxId = cmbBenefitLinkTax.ItemData(cmbBenefitLinkTax.ListIndex)
                oBenefitLink.Amount = txtBenefitLinkAmount
                oAdmin.Update oBenefitLink:=oBenefitLink
            Case icBank:
                Dim oBank As CBank
                Set oBank = oAdmin.Banks(CLng(Mid$(tvwMain.SelectedItem.Tag, 2)))
                oBank.Name = txtBankName
                oBank.Address1 = txtBankAddress1
                oBank.Address2 = txtBankAddress2
                oBank.City = txtBankCity
                oBank.Code = txtBankCode
                oAdmin.Update oBank:=oBank
                LoadBanks
            Case icDependant:
                Dim oDependant As New CDependant
                Set oDependant = oAdmin.Employees(CLng(Mid$(tvwMain.SelectedItem.Parent.Parent.Tag, 2))).Dependants(CLng(lblDependantID))
                oDependant.FirstName = txtDependantFirstName
                oDependant.LastName = txtDependantLastName
                oDependant.DateOfBirth = txtDependantBD
                oDependant.DepTypeId = cmbDependantType.ItemData(cmbDependantType.ListIndex)
                If optDependantGender(0) Then
                    oDependant.Gender = True
                Else
                    oDependant.Gender = False
                End If
                If optDependantStatus(0) Then
                    oDependant.Status = True
                Else
                    oDependant.Status = False
                End If
                oAdmin.Update oDependant:=oDependant
        End Select

Dim sKeyMain    As String
Dim sKeySub     As String

Select Case CurrentPanel
Case icDependant, icBenefitLink
    bUpdate = True
    sKeySub = tvwMain.SelectedItem.Tag
    sKeyMain = tvwMain.SelectedItem.Parent.Parent.Tag
    If bAdmin Then
        ShowAdmin
    Else
        ShowUser
    End If
    Set tvwMain.SelectedItem = tvwMain.Nodes(sKeyMain)
    tvwMain_NodeClick tvwMain.Nodes(sKeyMain)
    Set tvwMain.SelectedItem = tvwMain.Nodes(sKeySub & "!" & sKeyMain)
    bUpdate = False
    tvwMain_NodeClick tvwMain.Nodes(sKeySub & "!" & sKeyMain)
Case Else
    sKeyMain = tvwMain.SelectedItem.Tag
    If bAdmin Then
        ShowAdmin
    Else
        ShowUser
    End If
    Set tvwMain.SelectedItem = tvwMain.Nodes(sKeyMain)
    tvwMain_NodeClick tvwMain.Nodes(sKeyMain)
End Select
        
    Case "Cancel":
        btUpdate.Caption = "&Update"
        btUpdate.Enabled = False
        btInsert.Caption = "&Insert"
        pnlMain(CurrentPanel).Visible = False
        MoveButtons 0
        btDelete.Enabled = False
        fraTreeView.Enabled = True
End Select
btInsert.Visible = True
btUpdate.Visible = True
btDelete.Visible = True
Screen.MousePointer = vbDefault
Exit Sub

errbtUpdate_Click:
    MsgBox Err.Description, vbExclamation, "Update Error"
    btInsert.Enabled = False
    btUpdate.Enabled = True
    btDelete.Enabled = True
    btInsert.Visible = True
    btUpdate.Visible = True
    btDelete.Visible = True
    Screen.MousePointer = vbDefault
    Exit Sub
End Sub

Private Sub optDatabase_Click(Index As Integer)
Dim sTemp As String
If Index = 0 Then sTemp = InputBox$("Please enter the datasource name.", App.Title, "benefits")
If Index = 1 Then sTemp = InputBox$("Please enter the UNC of the database file.", App.Title)
sTemp = Trim$(sTemp)
If Len(sTemp) Then sDataSource = sTemp
lblStatus = "Current Data Source = " & sTemp
End Sub

Private Sub optDatabase_DblClick(Index As Integer)
Dim sTemp As String
If Index = 0 Then sTemp = InputBox$("Please enter the datasource name.", App.Title, "benefits")
If Index = 1 Then sTemp = InputBox$("Please enter the UNC of the database file.", App.Title)
sTemp = Trim$(sTemp)
If Len(sTemp) Then sDataSource = sTemp
lblStatus = "Current Data Source = " & sTemp
End Sub

Private Sub pnlHead_Resize()
On Error Resume Next
Dim iLbl   As Integer
Dim iWidth As Integer

iWidth = pnlHead.Width
iLbl = lblCurrent.Width + 100
If iWidth < 2325 Then lblCurrent.Visible = False: Exit Sub
If (iWidth - 2325) < iLbl Then lblCurrent.Visible = False: Exit Sub
lblCurrent.Left = iWidth - iLbl
End Sub

Private Sub tvwMain_NodeClick(ByVal Node As ComctlLib.Node)
On Error Resume Next
Dim sTag As String
Select Case Node.Text
    Case "Employees", "Banks", "Benefits", "Dependants"
        pnlMain(CurrentPanel).Visible = False
        MoveButtons 0
        btInsert.Enabled = True
        btUpdate.Enabled = False
        btDelete.Enabled = False
End Select

sTag = Node.Parent.Parent.Tag
Select Case Left$(Node.Tag, 1)
    Case "B"
        DspBank
        ShowPanel icBank
    Case "E"
        DspEmployee
        If Not bUpdate Then ShowPanel icEmployee
    Case "F"
        If Len(sTag) Then
            If Left$(sTag, 1) = "E" Then
                DspBenefitLink
                ShowPanel icBenefitLink
            Else
                DspBenefit
                ShowPanel icBenefit
            End If
        Else
            DspBenefit
            ShowPanel icBenefit
        End If
    Case "D"
        DspDependant
        ShowPanel icDependant
End Select
End Sub

Private Sub UserDocument_Initialize()
lblStatus = "Current Data Source = " & sDataSource
lblStatus.Refresh
End Sub

Private Sub UserDocument_Terminate()
On Error Resume Next
If Not (oAdmin Is Nothing) Then oAdmin.Term
Set oAdmin = Nothing
End Sub

