[
	uuid(11a7a860-5918-11d0-b435-00aa00c0803b),
	version(1.0),
	helpstring("Corporate Benefits Sample [C++ Remote Server]")
]
library BenefitsCPPRemote
{
	importlib("stdole32.tlb");

	typedef enum LinkServer {
		icLnkVB = 512,
		icLnkATL = 1024,
		icLnkCPP = 2048,
		icLnkMFC = 4096
	} tagLinkServer;

	typedef enum RemoteServer {
		icRemVB = 16,
		icRemATL = 32,
		icRemCPP = 64,
		icRemMFC = 128
	} tagRemoteServer;

	typedef enum SourceServer {
		icDoDataDirect = 1,
		icDoDataRemote = 2,
		icDoDataLinked = 4
	} tagSourceServer;

	typedef enum UserType {
		icInvalidUser = 0,
		icValidUser = 1,
		icValidAdmin = 2
	} tagUserType;

