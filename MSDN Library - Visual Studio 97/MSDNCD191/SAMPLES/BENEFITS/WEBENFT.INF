[Microsoft Access]
DatabasePath = "database\benefits.mdb"
DBConnectString = "DBQ=<%#DatabaseFilePath#%>;DefaultDir=<%#DatabaseDir#%>;Driver={Microsoft Access Driver (*.mdb)};DriverId=25;FIL=MS Access;ImplicitCommitSync=Yes;MaxBufferSize=512;MaxScanRows=8;PageTimeout=5;Threads=3;UID=admin;UserCommitSync=Yes;"