[Version]
AdvancedInf = 2
Signature ="$CHICAGO$"
SetupClass = Base

[DefaultInstall]
CopyFiles=InfFiles,Files_0
CustomDestination= PDCDest
RequiredEngine = setupapi;
AddReg = RegVersion,DocKey

[DefaultUninstall]
DelFiles=InfFiles,Files_0
CustomDestination= PDCDest
DelReg = RegVersion,DocKey

[DestinationDirs]
Files_0=49000,"\tools\wia\"
InfFiles=17,"msddk\3790.1830"
DefaultDestDir=49000,"TOOL_wia"

[RegVersion]
"HKLM","SOFTWARE\Microsoft\WINDDK\Restart\Cabs","TOOL_wia",0,"done"

[PDCDest]
49000,49001,49002=SDKCust, 17

[SDKCust]
;if key below exists, use this string to seed install path
"HKLM", "Software\Microsoft\WINDDK", "SFNDirectory",,"%DefaultDir%"

[DocKey]

[InfFiles]
TOOL_wia.inf


[Files_0]
.empty ,TOOL_wia_FILE_0,,

[SourceDisksNames]
1="TOOL_wia.cab",TOOL_wia.cab,0
[SourceDisksFiles]
TOOL_wia_FILE_0=1,,3


