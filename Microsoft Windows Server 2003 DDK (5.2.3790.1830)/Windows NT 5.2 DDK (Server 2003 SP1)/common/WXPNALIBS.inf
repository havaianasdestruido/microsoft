[Version]
AdvancedInf = 2
Signature ="$CHICAGO$"
SetupClass = Base

[DefaultInstall]
CopyFiles=InfFiles,Files_0
CustomDestination= PDCDest
RequiredEngine = setupapi;
AddReg = RegVersion,DocKey

[DefaultUninstall]
DelFiles=InfFiles,Files_0
CustomDestination= PDCDest
DelReg = RegVersion,DocKey

[DestinationDirs]
Files_0=49000,"\lib\wxp\"
InfFiles=17,"msddk\3790.1830"
DefaultDestDir=49000,"WXPNALIBS"

[RegVersion]
"HKLM","SOFTWARE\Microsoft\WINDDK\Restart\Cabs","WXPNALIBS",0,"done"

[PDCDest]
49000,49001,49002=SDKCust, 17

[SDKCust]
;if key below exists, use this string to seed install path
"HKLM", "Software\Microsoft\WINDDK", "SFNDirectory",,"%DefaultDir%"

[DocKey]

[InfFiles]
WXPNALIBS.inf


[Files_0]
stub512.com,WXPNALIBS_FILE_0,,

[SourceDisksNames]
1="WXPNALIBS.cab",WXPNALIBS.cab,0
[SourceDisksFiles]
WXPNALIBS_FILE_0=1,,512


[Strings]
FriendlyName=Wxp_Library_Files
AppKey=SOFTWARE\Microsoft\WINDDK
FileCount=1
TotalSize=512
